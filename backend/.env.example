###############################################
# CivicAI Backend - Example Environment File  #
# Copy this file to .env and fill the values. #
###############################################

# Backend server port
PORT=4000

# CORS allowed origins (comma-separated). Leave empty to allow any localhost during dev.
# Example: http://localhost:3000,http://localhost:5173
CLIENT_ORIGIN=

# Google Generative AI (Gemini)
# Get an API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Default model used by backend/src/gemini.js
# Options include: gemini-2.5-flash, gemini-2.5-flash-lite, etc.
GEMINI_MODEL_NAME=gemini-2.5-flash

###############################################
# Email Service Configuration                 #
# Required for Complaint Forwarding Feature   #
###############################################

# Email SMTP Configuration
# ------------------------
# For Gmail (Recommended for testing):
# 1. Enable 2-factor authentication on your Google account
# 2. Generate an "App Password" at: https://myaccount.google.com/apppasswords
# 3. Use your Gmail address and the generated app password below

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password-here
EMAIL_FROM=civic-ai@pmc.gov.in

# Alternative: SendGrid Configuration
# Uncomment below and comment Gmail settings above to use SendGrid
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=apikey
# EMAIL_PASSWORD=your-sendgrid-api-key
# EMAIL_FROM=noreply@yourdomain.com

# Alternative: Other SMTP Providers
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587 (or 465 for SSL)
# EMAIL_SECURE=false (set to true for port 465)
# EMAIL_USER=your-smtp-username
# EMAIL_PASSWORD=your-smtp-password
# EMAIL_FROM=noreply@yourdomain.com

# Notes:
# - EMAIL_SECURE should be 'true' only for port 465 (SSL)
# - For port 587, use EMAIL_SECURE=false (uses STARTTLS)
# - Whitelist your server IP if using corporate SMTP servers
# - Without email config, forwarding feature will show error message
